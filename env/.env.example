# ============================================================
# 环境变量 - 本地私有配置模板
# ------------------------------------------------------------
# 用法：复制本文件为 .env.local，填入你的真实值
#
#   cp env/.env.example env/.env.local
#
# .env.local 已被 .gitignore 忽略（*.local），不会被提交。
# Vite 的加载优先级：.env < .env.local < .env.[mode] < .env.[mode].local
# 因此这里填的值会覆盖 env/.env 中的同名默认值。
#
# ⚠️ 只填你实际用到的项，留空则回退到 env/.env 的默认值。
# ⚠️ 注释只能用 #，不能用 //（dotenv 只认 #）。
# ============================================================

# ---------- 应用标识 ----------

# DCloud AppID，格式 __UNI__XXXXXXX
# 获取：https://dev.dcloud.net.cn/ → 应用列表 → 你的应用 → AppID
# 只在打 App 端时需要；只做微信小程序可以留空
VITE_UNI_APPID =

# 微信小程序 AppID，格式 wx 开头 18 位
# 获取：https://mp.weixin.qq.com → 开发 → 开发管理 → 开发设置 → AppID
# 注意：小程序端用的是 manifest 里的 mp-weixin.appid，就是读这一项
VITE_WX_APPID =

# ---------- 接口地址 ----------

# 开发环境后端地址（AppDefine.ts 的 development 分支读取）
# 例：http://localhost:8081 或 http://<你的公网IP>:8081
VITE_API_BASE_URL_DEV =

# 测试环境后端地址（AppDefine.ts 的 test 分支读取）
VITE_API_BASE_URL_TEST =

# 生产环境后端地址（AppDefine.ts 的 production 分支读取）
VITE_API_BASE_URL_PROD =

# ---------- H5 地址 ----------

# 正式环境 H5 站点地址，小程序内 webview / 分享链接用
VITE_APP_H5_URL_ZS =

# 体验版 H5 站点地址
VITE_APP_H5_URL_TEST =

# ---------- 静态资源 ----------

# OSS 存储根地址（不带结尾斜杠），图片 / 图标 / 字体都从这里加载
# 例：https://your-bucket.oss-cn-hangzhou.aliyuncs.com
#
# 代码里的用法（TS / 模板统一走工具函数）：
#   ossUrl('/weapp/mine/icon.png')     ← src/utils/base.ts 导出的工具函数
#   <image :src="ossUrl('/weapp/mine/icon.png')" />
#   'background-image': `url(${ossUrl('/weapp/bg.png')})`   ← 行内 style 里这样用
#
# 注意：不要在 .scss 里拼这个地址（SCSS 读不到环境变量），
#       需要背景图时把 background-image 写到模板的 :style 里。
#
# 留空则所有远程图片都不显示（本地可用 public/ 目录放占位图）
VITE_APP_OSS_BASE =

# ---------- 其他 ----------

# WebView 页面加载的 AI 页面地址
VITE_APP_AI_WEBVIEW_URL =

# ---------- 调试开关 ----------

# 是否跳过登录校验
#   'true' ：不调后端登录接口，直接进入主界面（底部菜单正常显示），
#            且接口失败时静默处理——不弹错误提示、不跳登录页。
#   'false'：走正常微信登录流程（默认）。
#
# 适用场景：
#   1. 后端还没搭好，想先看界面
#   2. 用的 appid 与后端绑定的小程序不一致，登录接口会拒绝
#   3. 演示 / 截图时不想走登录
VITE_APP_SKIP_LOGIN =
