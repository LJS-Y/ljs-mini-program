# ============================================================
# 环境变量 - 公共配置（会提交到仓库）
# ------------------------------------------------------------
# ⚠️ 本文件不放任何真实密钥 / 客户信息，只保留可直接开箱的默认值。
#    需要填真实值（AppID、接口地址等）请复制 .env.example 到 .env.local：
#
#      cp env/.env.example env/.env.local
#
#    再编辑 .env.local 填入你的值。.env.local 已被 .gitignore 忽略
#    （规则为 *.local），不会被提交，且优先级高于本文件。
#
# ⚠️ 注释只能用 #，不能用 //。
#    dotenv 只认 #，写成 `值 // 注释` 会把注释一起当成值的一部分。
# ============================================================

# 应用信息（非敏感，可直接改）
VITE_APP_TITLE = 'LJS小程序'
VITE_APP_COMPANY_OWNER = 'LJS'
VITE_APP_PORT = 9000

# DCloud AppID（App 端打包用，格式 __UNI__XXXXXXX）
# 真实值放 env/.env.local；微信小程序端不依赖此项
VITE_UNI_APPID = ''

# 微信小程序 AppID（去 https://mp.weixin.qq.com 获取）
# 真实值放 env/.env.local
VITE_WX_APPID = ''

# H5 部署网站的 base，对应 manifest.config.ts 的 h5.router.base
VITE_APP_PUBLIC_BASE = '/unibest/'

# 是否配置 H5 代理
VITE_APP_PROXY = false
VITE_APP_PROXY_PREFIX = '/api'

# 服务端基础地址（留空则用 request 拦截器里的默认值）
VITE_SERVER_BASEURL = ''

# H5 站点地址（小程序内 webview / 分享链接用）
# 真实值放 env/.env.local
VITE_APP_H5_URL_ZS = '' # 正式环境
VITE_APP_H5_URL_TEST = '' # 体验版

# 静态资源（图片 / 字体 / 图标）的 OSS 存储根地址
# 真实值放 env/.env.local，例：'https://your-bucket.oss-cn-hangzhou.aliyuncs.com'
# 代码里统一走 ossUrl() 拼接（见 src/utils/base.ts）
VITE_APP_OSS_BASE = ''
